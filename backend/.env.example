NODE_ENV=development
PORT=4000

# Local Postgres, or a free hosted dev database (Neon, Supabase).
# Hosted providers usually require ?sslmode=require on the end.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodos

# Generate real values before deploying:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production if these are missing.
JWT_ACCESS_SECRET=
OTP_PEPPER=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# OTP behaviour
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_PER_HOUR=5

# Returns the OTP in the API response so the apps work before an SMS gateway is
# connected. Forced off when NODE_ENV=production.
EXPOSE_OTP_IN_RESPONSE=true

# console prints the code to the terminal. msg91 needs DLT-approved templates.
SMS_PROVIDER=console
DEFAULT_COUNTRY_CODE=+91

# Browser origins allowed to call the API. Phones on the local network are
# allowed automatically while NODE_ENV is not production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
