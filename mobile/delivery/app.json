{
  "expo": {
    "name": "Foodos Delivery",
    "slug": "foodos-delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "foodosdelivery",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "in.foodos.delivery"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a5c35",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.foodos.delivery",
      "versionCode": 1,
      "permissions": [
        "VIBRATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a5c35",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Foodos Delivery uses your location while the app is open to show how far each pickup is and to let customers follow their order."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1a5c35"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
